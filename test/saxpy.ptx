//
// y[i] = a * x[i] + y[i] for i < n, one element per thread.
// Hand-written PTX used by the integration test as ptxas input.
//
.version 8.0
.target sm_89
.address_size 64

.visible .entry saxpy(
    .param .u64 saxpy_param_x,
    .param .u64 saxpy_param_y,
    .param .f32 saxpy_param_a,
    .param .u32 saxpy_param_n
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<8>;
    .reg .f32   %f<5>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [saxpy_param_x];
    ld.param.u64    %rd2, [saxpy_param_y];
    ld.param.f32    %f1, [saxpy_param_a];
    ld.param.u32    %r1, [saxpy_param_n];
    mov.u32         %r2, %ctaid.x;
    mov.u32         %r3, %ntid.x;
    mov.u32         %r4, %tid.x;
    mad.lo.s32      %r5, %r2, %r3, %r4;
    setp.ge.u32     %p1, %r5, %r1;
    @%p1 bra        DONE;
    cvta.to.global.u64 %rd3, %rd1;
    cvta.to.global.u64 %rd4, %rd2;
    mul.wide.u32    %rd5, %r5, 4;
    add.s64         %rd6, %rd3, %rd5;
    add.s64         %rd7, %rd4, %rd5;
    ld.global.f32   %f2, [%rd6];
    ld.global.f32   %f3, [%rd7];
    fma.rn.f32      %f4, %f1, %f2, %f3;
    st.global.f32   [%rd7], %f4;
DONE:
    ret;
}
